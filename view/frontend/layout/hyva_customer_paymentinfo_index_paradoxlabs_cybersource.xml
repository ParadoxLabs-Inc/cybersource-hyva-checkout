<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Hyva theme: swap the Luma per-method paymentinfo templates for the shared
             TokenBaseHyvaCheckout ones, and attach the Unified Checkout payment pane. -->
        <referenceBlock name="tokenbase_manage_paradoxlabs_cybersource" template="ParadoxLabs_TokenBaseHyvaCheckout::customer/method.phtml"/>
        <referenceBlock name="tokenbase_manage_paradoxlabs_cybersource_cards" template="ParadoxLabs_TokenBaseHyvaCheckout::customer/cards.phtml"/>
        <referenceBlock name="tokenbase_manage_paradoxlabs_cybersource_form" template="ParadoxLabs_TokenBaseHyvaCheckout::customer/form.phtml">
            <block class="Magento\Framework\View\Element\Template" name="tokenbase_manage_paradoxlabs_cybersource_form_pane" as="payment_pane" template="ParadoxLabs_CyberSourceHyvaCheckout::customer/form/cc.phtml"/>
        </referenceBlock>
    </body>
</page>
