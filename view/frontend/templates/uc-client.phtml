/**
 * Shared Unified Checkout client transport for Hyva pages (checkout + customer payment options).
 *
 * Hyva counterpart of the base module's view/base/web/js/unified-checkout-client.js AMD module:
 * JWT decoding, UC.js injection with SRI (plain script tag — Hyva has no AMD loader, so the UMD
 * bundle sets window.Accept), the Accept mount chain, and the error surface. Each page keeps its
 * own state machine; only this genuinely identical plumbing is shared.
 *
 * Included via $block->fetchView() from the consuming templates; the window guard makes double
 * inclusion harmless.
 */

/** @var Hyva\Theme\ViewModel\HyvaCsp $hyvaCsp */
?>
<script>
    'use strict';

    (function () {
        if (window.pdlCybsUc) {
            return;
        }

        // JWT expiry handling: act this far ahead of exp, floor delays (client clock skew), fall
        // back to ~14 minutes when a JWT carries no usable exp claim (server-side TTL ~15 minutes).
        const EXPIRY_MARGIN_MS = 60 * 1000;
        const MIN_EXPIRY_DELAY_MS = 30 * 1000;
        const FALLBACK_TTL_MS = 14 * 60 * 1000;
        // Ceiling on the height floor ratchetHeight() will hold, as a backstop against a
        // pathological grow-measure-grow cycle. UC's tallest screens land well under this.
        const MAX_RATCHET_PX = 1000;
        // Rendered height at or below which the payment-selection list is taken to hold a single
        // button. UC sizes that frame itself from its own resize message; a lone card button measured
        // 45px against the 0.34 library, and a second button roughly doubles it. Deliberately tight:
        // read too high and the list is simply left alone, whereas reading too low would hide real
        // wallet buttons, so the slack all sits on the safe side.
        const SINGLE_BUTTON_MAX_PX = 60;
        // Polling for that list to render and stop resizing before it is measured; ~3s of headroom.
        const SELECTION_POLL_MS = 150;
        const SELECTION_POLL_LIMIT = 20;
        // CyberSource numeric card-type codes -> Magento type code + display brand. Must agree with
        // the server-side map in the base module's Model/Source/CardType, which remains
        // authoritative for the stored cc_type.
        const CARD_TYPES = {
            '001': {type: 'VI', label: 'Visa'},
            '002': {type: 'MC', label: 'Mastercard'},
            '003': {type: 'AE', label: 'American Express'},
            '004': {type: 'DI', label: 'Discover'},
            '005': {type: 'DN', label: 'Diners Club'},
            '007': {type: 'JCB', label: 'JCB'},
            '042': {type: 'MI', label: 'Maestro'},
        };
        // UC metadata.paymentType values for wallets -> display labels (proper nouns; not
        // translated), for transient tokens that carry no card fields. PANENTRY is deliberately
        // absent.
        const WALLET_LABELS = {
            'APPLEPAY': 'Apple Pay',
            'GOOGLEPAY': 'Google Pay',
            'CLICKTOPAY': 'Click to Pay',
            'PAZE': 'Paze',
        };

        window.pdlCybsUc = {
            /**
             * Base64url-decode the JWT payload (middle segment) and parse as JSON.
             */
            decodeJwtBody(jwt) {
                let payload = jwt.split('.')[1];
                payload = payload.replace(/-/g, '+').replace(/_/g, '/');
                while (payload.length % 4) {
                    payload += '=';
                }

                return JSON.parse(window.atob(payload));
            },

            /**
             * Normalize a transient-token claim field to its scalar string value, or null.
             *
             * Real gda-token payloads wrap scalars as {"value": "..."} objects and serialize absent
             * fields as empty arrays; tolerate wrapped objects, bare scalars, and both absent
             * shapes.
             */
            getTokenFieldValue(field) {
                if (field !== null && typeof field === 'object') {
                    field = field.value;
                }

                if (typeof field === 'string' && field.length > 0) {
                    return field;
                }

                if (typeof field === 'number') {
                    return String(field);
                }

                return null;
            },

            /**
             * Extract display card metadata from a transient-token JWT.
             *
             * The token payload carries the masked number, bin, expiration, and numeric type under
             * content.paymentInformation.card (UC Transient Token Format); wallet tokens may omit
             * some or all card fields but identify themselves via metadata.paymentType. Never
             * throws — any malformed input yields null, and absent fields yield null members.
             *
             * @return {Object|null} {type, label, last4, bin, expMonth, expYear, paymentType}
             */
            getCardMetadata(jwt) {
                try {
                    const body = this.decodeJwtBody(jwt);
                    const card = body.content
                        && body.content.paymentInformation
                        && body.content.paymentInformation.card
                        || {};
                    const number = card.number !== null && typeof card.number === 'object' ? card.number : {};
                    const masked = this.getTokenFieldValue(number.maskedValue);
                    const last4Match = masked !== null ? masked.match(/(\d{1,4})$/) : null;
                    const typeInfo = CARD_TYPES[this.getTokenFieldValue(card.type)] || null;

                    return {
                        type: typeInfo ? typeInfo.type : null,
                        label: typeInfo ? typeInfo.label : null,
                        last4: last4Match !== null ? last4Match[1] : null,
                        bin: this.getTokenFieldValue(number.bin),
                        expMonth: this.getTokenFieldValue(card.expirationMonth),
                        expYear: this.getTokenFieldValue(card.expirationYear),
                        paymentType: body.metadata ? this.getTokenFieldValue(body.metadata.paymentType) : null,
                    };
                } catch (error) {
                    return null;
                }
            },

            /**
             * Display label for a UC wallet paymentType, or null for card entry/unknown types.
             */
            getWalletLabel(paymentType) {
                return WALLET_LABELS[paymentType] || null;
            },

            /**
             * How long to wait before acting on a JWT's expiry. Floored rather than zero because a
             * skewed client clock can read a fresh JWT as already expired, and a zero delay means
             * an unbounded loop of signed capture-context calls.
             */
            getRefreshDelay(jwt) {
                let expiry = null;

                try {
                    const body = this.decodeJwtBody(jwt);
                    expiry = typeof body.exp === 'number' ? body.exp * 1000 : null;
                } catch (error) {
                    expiry = null;
                }

                if (expiry === null) {
                    return FALLBACK_TTL_MS;
                }

                return Math.max(MIN_EXPIRY_DELAY_MS, expiry - Date.now() - EXPIRY_MARGIN_MS);
            },

            /**
             * Decode the capture-context JWT for the UC client library URL + SRI hash and inject it
             * as a plain script tag. Resolves once window.Accept is available; rejects with an
             * Error message suitable for display.
             */
            loadClientLibrary(captureContext) {
                return new Promise((resolve, reject) => {
                    let ctx;

                    try {
                        ctx = this.decodeJwtBody(captureContext).ctx[0].data;
                    } catch (error) {
                        reject(new Error('Invalid capture context'));

                        return;
                    }

                    const existing = document.querySelector(
                        'script[data-uc-lib="' + CSS.escape(ctx.clientLibrary) + '"]'
                    );

                    if (existing) {
                        if (typeof window.Accept === 'function') {
                            resolve();
                        } else {
                            existing.addEventListener('load', () => resolve());
                            existing.addEventListener('error', () => reject(
                                new Error('Unable to load payment library')
                            ));
                        }

                        return;
                    }

                    const script = document.createElement('script');
                    script.type = 'text/javascript';
                    script.src = ctx.clientLibrary;
                    script.setAttribute('data-uc-lib', ctx.clientLibrary);

                    if (ctx.clientLibraryIntegrity) {
                        script.integrity = ctx.clientLibraryIntegrity;
                        script.crossOrigin = 'anonymous';
                    }

                    script.addEventListener('load', () => {
                        if (typeof window.Accept === 'function') {
                            resolve();
                        } else {
                            reject(new Error('Payment library unavailable'));
                        }
                    });
                    script.addEventListener('error', () => {
                        // Remove the dead tag so a retry re-fetches instead of reusing it.
                        script.remove();
                        reject(new Error('Unable to load payment library'));
                    });

                    document.head.appendChild(script);
                });
            },

            /**
             * Mount the UC drop-in via the Accept global into the embedded containers; resolves to
             * the captured transient-token JWT.
             */
            mountUnifiedPayments(captureContext, selectionSelector, screenSelector) {
                // Marks this mount as the current one. skipLoneCardButton() watches the DOM on a
                // timer, so a teardown and re-mount inside its polling window would otherwise let
                // the superseded watcher swap in a screen built from a spent capture context.
                const generation = this._mountSeq = (this._mountSeq || 0) + 1;

                // Idempotent, and armed before the mount so the very first screen sets the floor.
                this.ratchetHeight(selectionSelector, screenSelector);

                return window.Accept(captureContext)
                    .then(acceptInstance => {
                        // false = embedded layout (sidebar rejects the paymentScreen container)
                        return acceptInstance.unifiedPayments(false);
                    })
                    .then(unifiedPayments => {
                        // Both routes to a transient token stay live: the button list the customer
                        // can click, and the card screen swapped in for a lone card button. Whichever
                        // the customer completes settles first and wins; the other never settles.
                        return Promise.race([
                            unifiedPayments.show({
                                containers: {
                                    paymentSelection: selectionSelector,
                                    paymentScreen: screenSelector,
                                },
                            }),
                            this.skipLoneCardButton(
                                unifiedPayments,
                                captureContext,
                                selectionSelector,
                                screenSelector,
                                generation
                            ),
                        ]);
                    });
            },

            /**
             * Replace a payment-selection list that turned out to hold a single card button with the
             * card entry screen it would have opened.
             *
             * UC renders its button list even when only PANENTRY is allowed, so a card-only merchant
             * makes every customer click "Pay with card" before they can type anything.
             * createTrigger('PANENTRY') opens that same screen directly — it runs against the live
             * unifiedPayments instance and its already-initialized card-entry frame, so this is a
             * swap, not a re-mount: no teardown and no second capture context.
             *
             * Deciding after the mount rather than before is what makes it safe. The button list is
             * the only thing that knows which wallets a device can actually offer, so its rendered
             * height is the one honest signal for "there is nothing here but a card button".
             *
             * Resolves ONLY when the swap happens AND the customer completes card entry. Every other
             * outcome leaves it pending forever, so the caller racing this against show() is left
             * with exactly the behavior it had before.
             */
            skipLoneCardButton(
                unifiedPayments,
                captureContext,
                selectionSelector,
                screenSelector,
                generation
            ) {
                return new Promise(resolve => {
                    if (!this.isCardEntryAllowed(captureContext)) {
                        return;
                    }

                    this.whenSelectionSettled(selectionSelector, height => {
                        // A newer mount owns these containers now; this instance and its context
                        // are dead.
                        if (generation !== this._mountSeq || height > SINGLE_BUTTON_MAX_PX) {
                            return;
                        }

                        const selection = document.querySelector(selectionSelector);
                        let trigger;

                        try {
                            trigger = unifiedPayments.createTrigger(
                                'PANENTRY',
                                {containers: {paymentScreen: screenSelector}}
                            );
                        } catch (error) {
                            // Older libraries have no trigger, and it throws outright when the payment
                            // type was not requested. Either way the button list stands as-is.
                            return;
                        }

                        // The trigger does not hide the list itself — UC's own button handler does
                        // that separately — so a stale "Pay with card" would otherwise sit above the
                        // open form.
                        selection.style.display = 'none';
                        this.restoreSelectionOnDismissal(selectionSelector, screenSelector);

                        trigger.show().then(resolve, () => {
                            selection.style.display = '';
                        });
                    });
                });
            },

            /**
             * Whether the capture context allows manual card entry, which createTrigger('PANENTRY')
             * requires and throws without. Never throws — an undecodable context reads as "no".
             */
            isCardEntryAllowed(captureContext) {
                try {
                    const types = this.decodeJwtBody(captureContext).ctx[0].data.allowedPaymentTypes;

                    return Array.isArray(types) && types.includes('PANENTRY');
                } catch (error) {
                    return false;
                }
            },

            /**
             * Invoke onSettled with the rendered height of the payment-selection frame, once it has
             * stopped changing.
             *
             * UC paints the list and then resizes it to fit, so the first non-zero height read can be
             * an intermediate one — hence waiting for two consecutive equal readings rather than the
             * first. Gives up silently if it never settles, leaving the button list untouched.
             */
            whenSelectionSettled(selectionSelector, onSettled) {
                let attempts = 0;
                let previous = null;
                const poll = () => {
                    const frame = document.querySelector(selectionSelector + ' iframe');
                    const height = frame ? frame.offsetHeight : 0;

                    if (height > 0 && height === previous) {
                        onSettled(height);

                        return;
                    }

                    previous = height;
                    attempts++;

                    if (attempts < SELECTION_POLL_LIMIT) {
                        setTimeout(poll, SELECTION_POLL_MS);
                    }
                };

                setTimeout(poll, SELECTION_POLL_MS);
            },

            /**
             * Bring the hidden button list back if the swapped-in card screen is dismissed.
             *
             * The card screen carries its own back control, which tears its frame out of the screen
             * container. With the list hidden that would leave the customer facing nothing at all, and
             * the page's mount-health check would eventually spend a fresh capture context re-mounting
             * — counting the empty container as a mount failure while doing it. Restoring the list is
             * both cheaper and what the back control is meant to do: the live instance still has its
             * own button handler wired, so clicking through again resolves the raced show() promise.
             */
            restoreSelectionOnDismissal(selectionSelector, screenSelector) {
                const screen = document.querySelector(screenSelector);
                const selection = document.querySelector(selectionSelector);
                const wrapper = selection ? selection.parentElement : null;

                if (typeof window.MutationObserver !== 'function'
                    || screen === null
                    || wrapper === null
                    || wrapper.pdlUcRestore !== undefined) {
                    return;
                }

                const observer = new window.MutationObserver(() => {
                    if (screen.children.length > 0) {
                        return;
                    }

                    observer.disconnect();
                    delete wrapper.pdlUcRestore;
                    selection.style.display = '';
                });

                observer.observe(screen, {childList: true});
                wrapper.pdlUcRestore = observer;
            },

            /**
             * Hold the drop-in's wrapper at the tallest height its mount containers have reached.
             *
             * UC clears its containers between steps (payment selection -> card form -> review) and
             * paints the next screen a frame or more later, so the drop-in momentarily collapses to
             * near zero and everything below it — the save checkbox, agreements, Place Order — jumps
             * up and back down on every transition. A ratcheted min-height absorbs the collapse.
             * Growth is left alone: UC animates its own expansion, and clamping that would fight it.
             *
             * The floor goes on the wrapper, never on the mount containers themselves: the pages'
             * isDropinMounted() reads the screen container's own height to catch a UC iframe that
             * attached at 0x0, and a min-height there would make every dead mount measure as healthy.
             *
             * Heights are measured off the containers rather than the wrapper being written to.
             * Observing an element whose min-height we set invites a feedback loop wherever the
             * measurement and the min-height disagree on box model, each pass ratcheting up by the
             * padding.
             *
             * No-op without ResizeObserver — the drop-in just keeps bouncing, as it does today.
             */
            ratchetHeight(selectionSelector, screenSelector) {
                const containers = [
                    document.querySelector(selectionSelector),
                    document.querySelector(screenSelector),
                ].filter(Boolean);
                const wrapper = containers.length > 0 ? containers[0].parentElement : null;

                if (typeof window.ResizeObserver !== 'function'
                    || wrapper === null
                    || wrapper.pdlUcRatchet !== undefined) {
                    return;
                }

                let peak = 0;
                const observer = new window.ResizeObserver(() => {
                    const height = containers.reduce(
                        (total, container) => total + container.offsetHeight,
                        0
                    );

                    if (height > peak) {
                        peak = Math.min(height, MAX_RATCHET_PX);
                        wrapper.style.minHeight = peak + 'px';
                    }
                });

                containers.forEach(container => observer.observe(container));
                wrapper.pdlUcRatchet = observer;
            },

            /**
             * Drop the height floor, stop observing, and unhide the selection container. Callers
             * invoke this while tearing a mount down, so that a re-mount — or an error message
             * rendered where the drop-in was — inherits neither the discarded drop-in's height nor
             * its hidden button list.
             */
            releaseMountObservers(selectionSelector) {
                const selection = document.querySelector(selectionSelector);
                const wrapper = selection?.parentElement;

                if (selection) {
                    selection.style.display = '';
                }

                if (!wrapper) {
                    return;
                }

                if (wrapper.pdlUcRatchet !== undefined) {
                    wrapper.pdlUcRatchet.disconnect();
                    delete wrapper.pdlUcRatchet;
                    wrapper.style.minHeight = '';
                }

                if (wrapper.pdlUcRestore !== undefined) {
                    wrapper.pdlUcRestore.disconnect();
                    delete wrapper.pdlUcRestore;
                }
            },

            showError(message) {
                if (typeof window.dispatchMessages === 'function') {
                    window.dispatchMessages([{type: 'error', text: message}], 5000);
                } else {
                    window.alert(message);
                }
            },
        };
    })();
</script>
<?php if (isset($hyvaCsp)): ?>
    <?php $hyvaCsp->registerInlineScript() ?>
<?php endif; ?>
