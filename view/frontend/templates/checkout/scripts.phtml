use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var Hyva\Theme\ViewModel\HyvaCsp $hyvaCsp */

$code            = $escaper->escapeJs($block->getMethodCode());
$tServerError    = $escaper->escapeJs(__('A server error occurred. Please try again.'));
$tSessionExpired = $escaper->escapeJs(__('Your payment session expired. Please re-enter your card details.'));
$tLoadFailed     = $escaper->escapeJs(__('The payment form could not be loaded. Please reload the page and try again.'));
$tInvalidCvv     = $escaper->escapeJs(__('Please enter a valid CVV.'));
$tTotalChanged   = $escaper->escapeJs(__('Your order total changed. Please re-enter your card details.'));
$tCompleteForm   = $escaper->escapeJs(__('Please complete the payment form.'));
$inlineScript = <<<JS
    'use strict';

    window.addEventListener('checkout:init:validation', event => {
        hyvaCheckout.evaluation.registerValidator(
            'validate{$code}',
            async (element, component) => {
                return new Promise((resolve, reject) => {
                    window.dispatchEvent(
                        new CustomEvent('checkout:validate:{$code}', {detail: {resolve, reject}})
                    );
                });
            }
        );
    });

    function {$code}PaymentForm() {
        // How long after a mount is kicked off to verify the drop-in actually painted. The UC iframe
        // loads asynchronously and exposes no documented ready event, so this is a wall-clock check.
        const MOUNT_HEALTH_CHECK_MS = 3000;
        // Outer bound on a whole mount cycle (request -> UC.js load -> mount). The library load can
        // stall without ever calling back, which would leave the in-flight guard set and every future
        // mount attempt blocked; arming the health check when the cycle opens catches that stall.
        const CYCLE_TIMEOUT_MS = 45000;
        // Placeholder card id used to flag a freshly tokenized (not-yet-vaulted) card in the select.
        const NEW_CARD_ID = 'unified_checkout_new';
        // Consecutive-failure cap on mount attempts, so a persistent failure (e.g. UC.js blocked by
        // CSP) cannot turn every checkout event into a fresh signed capture-context API call forever.
        const MAX_MOUNT_FAILURES = 3;
        // -----------------------------------------------------------------------------------------
        // additional_data contract (prepareSubmit()):
        //   New card    => transient_token = <UC transient-token JWT>, card_id = ''.
        //   Stored card => transient_token = '', card_id = <vault hash>.
        // The synthetic NEW_CARD_ID select value never reaches the server as a card_id.
        // -----------------------------------------------------------------------------------------
        return {
            storedCards: this.\$wire.entangle('storedCards'),
            selectedCard: '',
            newCardEntered: false,
            transientToken: null,
            save: true,
            ccCid: '',
            loading: false,
            mountTotal: null,
            componentInitialized: false,
            config: {},
            state: {
                cc_cid_length: 3,
                cc_type: '',
            },

            // Mount cycle bookkeeping. A cycle spans request -> library load -> mount -> paint, all
            // async. _activeGeneration marks a cycle in flight for its whole life; bumping
            // _generation invalidates superseded cycles so their late callbacks are discarded —
            // otherwise a stale response could bind the drop-in to a different total than the order.
            _generation: 0,
            _activeGeneration: null,
            _mountFailures: 0,
            _lastSelectedCard: '',
            _abortController: null,
            _hidOrderButton: false,

            // Expiry timers, deliberately split: a lapsed capture context only matters while the
            // customer has yet to tokenize (silent re-mount), whereas a lapsed transient token
            // discards completed card entry and must be announced.
            _contextTimer: null,
            _tokenTimer: null,
            _healthTimer: null,

            initForm: function() {
                if (this.componentInitialized) {
                    return;
                }

                this.config = JSON.parse(this.\$el.dataset.config);
                this.selectedCard = this.config.selectedCard || '';
                this._lastSelectedCard = this.selectedCard;
                this.save = !!this.config.defaultSaveCard;

                window.addEventListener('checkout:validate:{$code}', this.prepareSubmit.bind(this));
                window.addEventListener('{$code}BillingUpdated', this.handleBillingUpdated.bind(this));
                // Hyva dispatches this on window (init-payment.phtml); a document listener never fires.
                window.addEventListener('checkout:payment:method-activate', this.handleMethodActivate.bind(this));
                // Dispatched by the Hyva place-order service processor on any placement failure; a
                // transient token is single-use and the capture context it was minted against is
                // spent once submitted, so a declined new-card attempt must never be resubmitted.
                window.addEventListener('order:place:{$code}:error', this.handleOrderError.bind(this));

                this.\$watch('selectedCard', this.handleSelectedCardChange.bind(this));

                this.loadFingerprint();
                this.updateStoredCardState();
                this.toggleOrderButton();
                this.maybeMountDropin();

                this.componentInitialized = true;
            },

            // --- Mount lifecycle -----------------------------------------------------------------

            isMethodActive: function() {
                const checked = document.querySelector('input[name="payment-method-option"]:checked');

                return !!checked && checked.value === '{$code}';
            },

            /**
             * Whether the drop-in is mounted AND usable. The UC iframe can attach at 0x0, leaving no
             * visible payment UI while a children-only check reports "mounted" forever — so a visible
             * container at zero height counts as unmounted. A hidden-but-healthy mount legitimately
             * measures zero, hence the visibility qualifier.
             */
            isDropinMounted: function() {
                const screen = document.getElementById('{$code}_uc_screen');

                if (!screen || screen.children.length === 0) {
                    return false;
                }

                return screen.offsetParent === null || screen.getBoundingClientRect().height > 0;
            },

            maybeMountDropin: function() {
                const screen = document.getElementById('{$code}_uc_screen');

                if (!this.isMethodActive()
                    || this.selectedCard !== ''
                    || screen === null
                    || this._activeGeneration !== null
                    || this._mountFailures >= MAX_MOUNT_FAILURES
                    || this.isDropinMounted()) {
                    return;
                }

                this.requestCaptureContext();
            },

            requestCaptureContext: function() {
                this.loading = true;

                const generation = ++this._generation;
                this._activeGeneration = generation;

                // Bound the whole cycle; mountUnifiedCheckout() re-arms at the shorter paint interval.
                this.scheduleMountHealthCheck(CYCLE_TIMEOUT_MS);

                // Record the total the capture mandate is minted against, for drift detection at
                // submit. Fire-and-forget alongside the context request; guarded by generation.
                this.\$wire.call('getQuoteTotal').then(total => {
                    if (this.isCurrentGeneration(generation)) {
                        this.mountTotal = total;
                    }
                });

                this._abortController = new AbortController();

                fetch(this.config.captureContextUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'X-Requested-With': 'XMLHttpRequest',
                    },
                    body: new URLSearchParams({
                        form_key: hyva.getFormKey(),
                        source: 'checkout',
                    }),
                    signal: this._abortController.signal,
                })
                .then(response => response.json().then(data => {
                    if (!response.ok) {
                        throw new Error(data && data.message ? data.message : 'Server error');
                    }

                    return data;
                }))
                .then(data => {
                    if (!this.isCurrentGeneration(generation)) {
                        return;
                    }

                    if (!data || !data.captureContext) {
                        this.handleMountError('Missing capture context');

                        return;
                    }

                    this.loadClientLibrary(data.captureContext, generation);
                })
                .catch(error => {
                    // fetch abort is an intentional teardown, not a failure.
                    if (error && error.name === 'AbortError') {
                        return;
                    }

                    if (this.isCurrentGeneration(generation)) {
                        this.handleMountError(error && error.message ? error.message : null);
                    }
                });
            },

            isCurrentGeneration: function(generation) {
                return generation === this._generation;
            },

            /**
             * Load UC.js via the shared client (script tag + SRI; UMD sets window.Accept), then
             * mount. Generation-guarded on both settle paths.
             */
            loadClientLibrary: function(captureContext, generation) {
                window.pdlCybsUc.loadClientLibrary(captureContext)
                    .then(() => {
                        if (this.isCurrentGeneration(generation)) {
                            this.mountUnifiedCheckout(captureContext, generation);
                        }
                    })
                    .catch(error => {
                        if (this.isCurrentGeneration(generation)) {
                            this.handleMountError(error && error.message ? error.message : null);
                        }
                    });
            },

            mountUnifiedCheckout: function(captureContext, generation) {
                if (!this.isCurrentGeneration(generation)) {
                    return;
                }

                if (typeof window.Accept !== 'function') {
                    this.handleMountError('Payment library unavailable');

                    return;
                }

                window.pdlCybsUc.mountUnifiedPayments(
                    captureContext,
                    '#{$code}_uc_selection',
                    '#{$code}_uc_screen'
                )
                    .then(transientTokenJwt => {
                        // A token from a superseded mount belongs to a dead context; never accept it.
                        if (this.isCurrentGeneration(generation)) {
                            this.handleTransientToken(transientTokenJwt);
                        }
                    })
                    .catch(error => {
                        if (this.isCurrentGeneration(generation)) {
                            this.handleMountError(error && error.message ? error.message : null);
                        }
                    });

                // NB: the failure latch is deliberately NOT cleared here — a mount being underway
                // proves nothing (the 0-height failure mode reaches this point every time). It is
                // cleared once checkMountHealth() confirms a healthy mount.
                this.loading = false;
                this.scheduleContextRefresh(captureContext);
                this.scheduleMountHealthCheck(MOUNT_HEALTH_CHECK_MS);
            },

            handleTransientToken: function(transientTokenJwt) {
                if (!transientTokenJwt) {
                    return;
                }

                this.transientToken = transientTokenJwt;
                this.newCardEntered = true;

                // Card entry is done: the capture context has served its purpose; the token's own
                // lifetime takes over. A pending health check is likewise moot.
                this.clearTimer('_contextTimer');
                this.clearTimer('_healthTimer');
                this._activeGeneration = null;
                this.scheduleTokenExpiry(transientTokenJwt);

                this.selectedCard = NEW_CARD_ID;
            },

            handleMountError: function(message) {
                this._mountFailures++;
                this.loading = false;

                // The cycle died here; release the in-flight guard so a retry is possible.
                this._activeGeneration = null;
                this.clearTimer('_healthTimer');

                this.showError(message || '{$tServerError}');
            },

            // --- Card selection ------------------------------------------------------------------

            handleSelectedCardChange: function() {
                const selected = this.selectedCard;

                if (selected === this._lastSelectedCard) {
                    return;
                }

                this._lastSelectedCard = selected;
                this.updateStoredCardState();
                this.toggleOrderButton();

                if (selected === NEW_CARD_ID) {
                    return;
                }

                if (selected) {
                    // A real stored card is now selected; abandon any pending/mounted drop-in.
                    this.resetDropinState();

                    return;
                }

                // Explicit return to "Add new card": clear the failure latch so a past transient
                // failure does not dead-end a deliberate retry.
                this._mountFailures = 0;

                // Re-entering a card after already tokenizing one: drop the captured token and its
                // timer so the abandoned token cannot outlive the entry it came from.
                if (this.transientToken) {
                    this.resetDropinState();
                }

                this.maybeMountDropin();
            },

            updateStoredCardState: function() {
                const selected = this.selectedCard;

                if (selected && selected !== NEW_CARD_ID) {
                    this.state.cc_type = this.storedCards[selected]?.type || '';
                    this.state.cc_cid_length = this.state.cc_type === 'AE' ? 4 : 3;
                }
            },

            handleMethodActivate: function(event) {
                this.toggleOrderButton(event);

                if (event && event.detail && event.detail.method === '{$code}') {
                    // Defer a tick so the payment form is visible before the mount health checks run.
                    window.setTimeout(this.maybeMountDropin.bind(this), 0);
                }
            },

            /**
             * A billing address change invalidates a capture context minted against the old billTo —
             * AVS data is baked into the resulting transient token, so a stale context yields avoidable
             * AVS declines. If the drop-in is mounted but nothing has been tokenized yet, re-mint against
             * the new billTo by remounting. Once a token exists we leave it: a billing edit must not
             * destroy completed card entry (matches the Luma renderer's behavior). The guards below
             * ensure repeated billing events cannot storm requests — we never act while a mount cycle is
             * in flight (its own context will carry the latest billTo), and the not-yet-mounted case
             * falls through to maybeMountDropin(), which is itself guarded.
             */
            handleBillingUpdated: function() {
                if (this._activeGeneration !== null) {
                    return;
                }

                if (this.transientToken) {
                    return;
                }

                if (this.isDropinMounted()) {
                    this.remountDropin();

                    return;
                }

                this.maybeMountDropin();
            },

            /**
             * Hide the place-order button while the drop-in is collecting card data — the drop-in
             * has its own continue button which resolves the transient token; place-order returns
             * once a stored card is selected or the new card is tokenized.
             */
            toggleOrderButton: function(event) {
                const method = event && event.detail
                    ? event.detail.method
                    : document.querySelector('input[name="payment-method-option"]:checked')?.value;

                const orderBtn = document.querySelector('.btn-primary[x-bind~="buttonPlaceOrder"]');

                if (!orderBtn) {
                    return;
                }

                // Only ever undo our own hide: every payment component shares this one button, so
                // unconditional writes from each would clobber one another on method switches.
                if (method === '{$code}' && this.selectedCard === '') {
                    orderBtn.style.display = 'none';
                    this._hidOrderButton = true;
                } else if (this._hidOrderButton) {
                    orderBtn.style.display = '';
                    this._hidOrderButton = false;
                }
            },

            // --- Expiry + health timers ----------------------------------------------------------

            clearTimer: function(handle) {
                if (this[handle]) {
                    clearTimeout(this[handle]);
                    this[handle] = null;
                }
            },

            scheduleContextRefresh: function(captureContext) {
                this.clearTimer('_contextTimer');

                this._contextTimer = setTimeout(
                    this.handleContextExpiry.bind(this),
                    window.pdlCybsUc.getRefreshDelay(captureContext)
                );
            },

            /**
             * The capture context lapsed with nothing entered that a re-mount would destroy; swap in
             * a fresh one silently — unless a token was captured, in which case the context is spent
             * and the token timer owns expiry.
             */
            handleContextExpiry: function() {
                this._contextTimer = null;

                if (this.transientToken) {
                    return;
                }

                this.remountDropin();
            },

            scheduleTokenExpiry: function(transientTokenJwt) {
                this.clearTimer('_tokenTimer');

                this._tokenTimer = setTimeout(
                    this.handleTokenExpiry.bind(this),
                    window.pdlCybsUc.getRefreshDelay(transientTokenJwt)
                );
            },

            /**
             * The captured token lapsed and the server would now reject it. Unlike a context refresh
             * this destroys completed card entry, so it is always announced.
             */
            handleTokenExpiry: function() {
                this._tokenTimer = null;

                this.remountDropin();

                this.showError(
                    '{$tSessionExpired}'
                );
            },

            scheduleMountHealthCheck: function(delay) {
                this.clearTimer('_healthTimer');

                this._healthTimer = setTimeout(this.checkMountHealth.bind(this), delay);
            },

            /**
             * Recover from a mount that attached but never became usable (the 0-height iframe case).
             * This is also the only place a mount is confirmed to have worked, so it owns clearing
             * the failure latch.
             */
            checkMountHealth: function() {
                this._healthTimer = null;

                // The mount cycle ends here however it went; release the in-flight guard before any
                // branch below can return.
                this._activeGeneration = null;

                // A captured token means card entry already succeeded and the token's own timer owns
                // expiry — mount health is moot and the generation must be left intact.
                if (this.transientToken) {
                    return;
                }

                const screen = document.getElementById('{$code}_uc_screen');

                if (screen === null || screen.offsetParent === null) {
                    // The container vanished or is hidden. A UC.js load still stalled in flight could
                    // resolve later and mount a stale context into this hidden container, arming timers
                    // with no visible UI. Bump the generation so any such late callback is discarded —
                    // releasing _activeGeneration alone (done above) would let a stale mount land.
                    this._generation++;

                    return;
                }

                if (this.isDropinMounted()) {
                    this._mountFailures = 0;

                    return;
                }

                this._mountFailures++;

                if (this._mountFailures >= MAX_MOUNT_FAILURES) {
                    this.showError(
                        '{$tLoadFailed}'
                    );

                    return;
                }

                this.remountDropin();
            },

            remountDropin: function() {
                this.resetDropinState();
                this.maybeMountDropin();
            },

            /**
             * Tear down any mounted/in-flight drop-in: cancel timers, abort the in-flight request,
             * drop the captured token + synthetic card, and empty the containers.
             */
            resetDropinState: function() {
                this.clearTimer('_contextTimer');
                this.clearTimer('_tokenTimer');
                this.clearTimer('_healthTimer');

                // Invalidate any cycle still in flight: bumping the generation makes its callbacks
                // no-ops, so a load or mount started before this teardown cannot land afterwards.
                this._generation++;
                this._activeGeneration = null;

                if (this._abortController) {
                    this._abortController.abort();
                    this._abortController = null;
                }

                this.transientToken = null;
                this.newCardEntered = false;
                this.mountTotal = null;
                this.loading = false;

                if (this.selectedCard === NEW_CARD_ID) {
                    this.selectedCard = '';
                }

                document.getElementById('{$code}_uc_selection')?.replaceChildren();
                document.getElementById('{$code}_uc_screen')?.replaceChildren();
            },

            // --- Submit --------------------------------------------------------------------------

            /**
             * A placement failure (decline, gateway error) spends the capture context the transient
             * token was minted against, so the token can never be resubmitted. Drop it and re-mint a
             * fresh drop-in so the next attempt tokenizes anew, rather than replaying a dead token.
             *
             * The decline message itself is surfaced by the server (evaluateCompletion) through the
             * standard messenger, so this reset stays silent — no showError() here — to avoid a
             * second, duplicate error. resetDropinState() does not touch the mount-failure latch, so
             * an ordinary decline never counts against MAX_MOUNT_FAILURES. Stored-card attempts have
             * no token to spend; remountDropin() is a no-op while a card is selected (guarded).
             */
            handleOrderError: function() {
                if (this.selectedCard === NEW_CARD_ID || this.transientToken) {
                    this.remountDropin();
                }
            },

            prepareSubmit: async function(event) {
                const resolve = event?.detail?.resolve || (() => {});
                const reject = event?.detail?.reject || (() => {});

                const payload = {
                    method: '{$code}',
                    card_id: '',
                    transient_token: '',
                    cc_cid: this.ccCid || '',
                    save: this.save ? '1' : '0',
                };

                if (this.selectedCard && this.selectedCard !== NEW_CARD_ID) {
                    if (this.config.requireCcv && this.ccCid.length !== this.state.cc_cid_length) {
                        this.showError('{$tInvalidCvv}');
                        reject();

                        return;
                    }

                    payload.card_id = this.selectedCard;
                } else if (this.transientToken) {
                    // The capture mandate amount is baked into the token; if the order total moved
                    // (coupon, shipping change) since the mount, force re-entry against a fresh,
                    // correctly-priced context instead of authorizing a mismatched amount.
                    try {
                        const total = await this.\$wire.call('getQuoteTotal');

                        if (this.mountTotal !== null && total !== this.mountTotal) {
                            this.remountDropin();
                            this.showError(
                                '{$tTotalChanged}'
                            );
                            reject();

                            return;
                        }
                    } catch (error) {
                        // Total verification is best-effort; the gateway enforces the real amount.
                    }

                    payload.transient_token = this.transientToken;
                } else {
                    this.showError('{$tCompleteForm}');
                    reject();

                    return;
                }

                hyvaCheckout.storage.setValue('payment', payload);
                resolve(true);
            },

            // --- Misc ----------------------------------------------------------------------------

            /**
             * Inject the CyberSource Decision Manager (online-metrix) device-fingerprint tag, once.
             */
            loadFingerprint: function() {
                if (!this.config.fingerprintUrl || this.config.fingerprintUrl.length <= 1) {
                    return;
                }

                if (document.querySelector('script[data-cybs-fingerprint]')) {
                    return;
                }

                const script = document.createElement('script');
                script.type = 'text/javascript';
                script.src = this.config.fingerprintUrl;
                script.setAttribute('data-cybs-fingerprint', this.config.fingerprintUrl);
                document.head.appendChild(script);
            },

            showError: function(message) {
                window.pdlCybsUc.showError(message);
            },

            validateCvv: function(e) {
                const cvv = e.target.value;
                const valid = (cvv.length === this.state.cc_cid_length);

                e.target.setCustomValidity(valid ? '' : '{$tInvalidCvv}');
                if (!valid) {
                    e.target.reportValidity();
                }
            },

            // --- Getters for template bindings ---
            getCcCidLength() {return this.state.cc_cid_length},
            getCcCidPlaceholder() {return this.state.cc_cid_length === 4 ? '0000' : '000'},
            showDropin() {return this.selectedCard === ''},
            showStoredCards() {return Object.keys(this.storedCards).length > 0 || this.newCardEntered},
            showCvvField() {return !!this.selectedCard && this.selectedCard !== NEW_CARD_ID},
            showSaveOption() {
                return this.config.canSaveCard
                    && this.newCardEntered
                    && this.selectedCard === NEW_CARD_ID;
            },
        }
    }

    window.addEventListener('alpine:init', () => Alpine.data('{$code}PaymentForm', {$code}PaymentForm), {once: true});
JS;
?>
<?= /* @noEscape */ $block->fetchView(
    $block->getTemplateFile('ParadoxLabs_CyberSourceHyvaCheckout::uc-client.phtml')
) ?>
<script><?= /* @noEscape */
    $inlineScript ?></script>
<?php $hyvaCsp->registerInlineScript() ?>
